# 48-char random URL-safe secret for Gemini Custom Connector path
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(36))"
MCP_SECRET_PATH=replace_with_48_char_random_urlsafe_token

# GitHub Fine-Grained PAT (Scoped to target repos: Contents R/W, Pull requests R/W, Issues R/W, Metadata R)
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Webhook Secret (for autonomous PR review triggers)
GITHUB_WEBHOOK_SECRET=replace_with_32_byte_hex_secret

# Optional: secondary webhook secret for zero-downtime rotation.
# Both GITHUB_WEBHOOK_SECRET and this value verify during the overlap window.
# Comma-separated lists are accepted in either variable.
GITHUB_WEBHOOK_SECRET_SECONDARY=

# Optional: webhook replay window / max clock skew in seconds (default 300)
WEBHOOK_REPLAY_TTL_SECONDS=300

# Optional: Default model override passed to `agy --model` (leave empty to use agy default)
AGY_MODEL=

# Optional: agy binary path and per-job timeout in seconds
AGY_BIN=/home/linuxbrew/.linuxbrew/bin/agy
AGY_TIMEOUT_SECONDS=600

# Optional: Webhook URL (Discord / Slack / ntfy) for push alerts when async swarm jobs finish
NOTIFY_WEBHOOK_URL=

# Local host paths (defaults are relative to <install-dir>)
JOB_DB_PATH=<install-dir>/data/jobs.db
WORKSPACES_DIR=<install-dir>/workspaces
PERSONAS_DIR=<install-dir>/personas
